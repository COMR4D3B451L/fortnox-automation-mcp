# Never commit real credentials. Use a secret manager or environment variables.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_ACCESS_TOKEN=
FORTNOX_REFRESH_TOKEN=
FORTNOX_COMPANY_ID=
FORTNOX_BASE_URL=https://api.fortnox.se
FORTNOX_AUDIT_LOG=./data/audit.jsonl
# Writes stay disabled unless this is exactly "1".
FORTNOX_ENABLE_WRITES=0
# Required for any financial mutation when writes are enabled.
# Generate a long random value out of band. Never commit it.
FORTNOX_APPROVAL_TOKEN=
# Optional: use a path outside the repository for rotated tokens.
FORTNOX_ENV_FILE=./.env
